# Postgres Configuration
POSTGRES__USER="postgres"
POSTGRES__PASSWORD="postgres"
POSTGRES__DB="project_dashboard_ci"
POSTGRES__PROTOCOL="postgresql+asyncpg"
POSTGRES__HOST="localhost"
POSTGRES__PORT="5432"


# JWT Configuration
JWT__SECRET_KEY="very_strong_secret_key_for_ci"
JWT__ALGORITHM='HS256'


# Document Configuration
DOCUMENT__MAX_PROJECT_STORAGE_BYTES = 500_000_000


# AWS Configuration
AWS__ACCESS_KEY_ID='my_access_key_id'
AWS__SECRET_ACCESS_KEY='very_strong_secret_key_for_ci'
AWS__REGION=eu-north-1
AWS__S3_BUCKET=project-dashboard-1